from enum import Enum
from queue import Queue
from threading import Thread, Lock
from time import sleep
from datetime import datetime
from pydantic import BaseModel
from typing import Optional, Dict, Any, List

# ===================== 1. 全局枚举 & 数据模型 =====================
class TaskStatus(Enum):
    PENDING = "待处理"
    RUNNING = "执行中"
    SUCCESS = "执行成功"
    FAILED = "执行失败"
    REJECT = "风控拦截"

class TaskType(Enum):
    CONTENT_CREATE = "内容创作"
    DATA_MONITOR = "数据监测"
    RISK_AUDIT = "风控审核"
    OP_PUBLISH = "运营发布"

class OpTask(BaseModel):
    task_id: str
    task_type: TaskType
    content: str
    status: TaskStatus = TaskStatus.PENDING
    result: Optional[str] = None
    create_time: str = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

# ===================== 2. 基础Agent父类 =====================
class BaseAgent:
    def __init__(self, name: str, task_queue: Queue, agent_registry: Dict[str, Any]):
        self.name = name
        self.task_queue = task_queue
        self.agent_registry = agent_registry
        self.running = False
        self.lock = Lock()

    def run(self):
        self.running = True
        Thread(target=self._loop, daemon=True).start()
        print(f"✅ 【{self.name}】启动成功")

    def stop(self):
        self.running = False
        print(f"❌ 【{self.name}】已停止")

    def _loop(self):
        while self.running:
            try:
                if not self.task_queue.empty():
                    task = self.task_queue.get()
                    self.handle_task(task)
                sleep(0.5)
            except Exception as e:
                print(f"⚠️ 【{self.name}】任务异常: {str(e)}")

    def handle_task(self, task: OpTask):
        """子类重写该方法实现业务逻辑"""
        pass

# ===================== 3. 各业务Agent实现 =====================
# 3.1 调度中心Agent
class ScheduleAgent(BaseAgent):
    def __init__(self, name: str, task_queue: Queue, agent_registry: Dict[str, Any]):
        super().__init__(name, task_queue, agent_registry)
        self.task_list: List[OpTask] = []

    def add_task(self, task: OpTask):
        """外部提交任务入口"""
        self.task_queue.put(task)
        with self.lock:
            self.task_list.append(task)
        print(f"📥 调度中心接收任务: {task.task_id} 类型:{task.task_type.value}")

    def handle_task(self, task: OpTask):
        # 根据任务类型分发给对应Agent
        task.status = TaskStatus.RUNNING
        if task.task_type == TaskType.CONTENT_CREATE:
            self.agent_registry["content_agent"].receive_task(task)
        elif task.task_type == TaskType.DATA_MONITOR:
            self.agent_registry["data_agent"].receive_task(task)
        elif task.task_type == TaskType.RISK_AUDIT:
            self.agent_registry["risk_agent"].receive_task(task)
        elif task.task_type == TaskType.OP_PUBLISH:
            self.agent_registry["publish_agent"].receive_task(task)

    def show_all_task(self):
        """查看所有任务状态"""
        print("\n========== 全量任务状态 ==========")
        for t in self.task_list:
            print(f"任务ID:{t.task_id} | 类型:{t.task_type.value} | 状态:{t.status.value} | 结果:{t.result}")

# 3.2 内容创作Agent
class ContentAgent(BaseAgent):
    def __init__(self, name: str, task_queue: Queue, agent_registry: Dict[str, Any]):
        super().__init__(name, task_queue, agent_registry)
        self.agent_task_queue = Queue()

    def receive_task(self, task: OpTask):
        self.agent_task_queue.put(task)

    def _loop(self):
        while self.running:
            if not self.agent_task_queue.empty():
                task = self.agent_task_queue.get()
                self.handle_task(task)
            sleep(0.5)

    def handle_task(self, task: OpTask):
        print(f"✍️ 内容创作Agent 开始创作: {task.task_id}")
        # 模拟AI文案生成
        sleep(1)
        art_content = f"【自动生成运营文案】主题：{task.content}，标题已优化，正文已排版完成"
        task.result = art_content
        task.status = TaskStatus.SUCCESS
        # 创作完成自动流转到风控审核
        self.agent_registry["schedule_agent"].add_task(
            OpTask(
                task_id=task.task_id,
                task_type=TaskType.RISK_AUDIT,
                content=art_content
            )
        )
        print(f"✅ 内容创作完成: {task.task_id}")

# 3.3 风控审核Agent
class RiskAuditAgent(BaseAgent):
    def __init__(self, name: str, task_queue: Queue, agent_registry: Dict[str, Any]):
        super().__init__(name, task_queue, agent_registry)
        self.agent_task_queue = Queue()

    def receive_task(self, task: OpTask):
        self.agent_task_queue.put(task)

    def _loop(self):
        while self.running:
            if not self.agent_task_queue.empty():
                task = self.agent_task_queue.get()
                self.handle_task(task)
            sleep(0.5)

    def handle_task(self, task: OpTask):
        print(f"🔍 风控审核Agent 检测内容: {task.task_id}")
        sleep(1)
        # 模拟合规检测
        if "违规" in task.content:
            task.status = TaskStatus.REJECT
            task.result = "内容含敏感词，风控拦截"
            print(f"⛔ 风控拦截任务: {task.task_id}")
        else:
            task.status = TaskStatus.SUCCESS
            task.result = "内容合规，审核通过"
            # 审核通过流转到运营发布
            self.agent_registry["schedule_agent"].add_task(
                OpTask(
                    task_id=task.task_id,
                    task_type=TaskType.OP_PUBLISH,
                    content=task.content
                )
            )
            print(f"✅ 风控审核通过: {task.task_id}")

