# ===================== 4. 系统初始化 & 启动 =====================
class MultiAgentOpSystem:
    def __init__(self):
        self.global_queue = Queue()
        # 代理注册中心
        self.agent_registry = {}
        # 初始化所有Agent
        self.schedule_agent = ScheduleAgent("调度中心Agent", self.global_queue, self.agent_registry)
        self.content_agent = ContentAgent("内容创作Agent", self.global_queue, self.agent_registry)
        self.risk_agent = RiskAuditAgent("风控审核Agent", self.global_queue, self.agent_registry)
        self.data_agent = DataMonitorAgent("数据监测Agent", self.global_queue, self.agent_registry)
        self.publish_agent = PublishAgent("运营发布Agent", self.global_queue, self.agent_registry)
        # 注册到注册表
        self.agent_registry["schedule_agent"] = self.schedule_agent
        self.agent_registry["content_agent"] = self.content_agent
        self.agent_registry["risk_agent"] = self.risk_agent
        self.agent_registry["data_agent"] = self.data_agent
        self.agent_registry["publish_agent"] = self.publish_agent

    def start_all_agent(self):
        """启动所有智能体"""
        self.schedule_agent.run()
        self.content_agent.run()
        self.risk_agent.run()
        self.data_agent.run()
        self.publish_agent.run()
        print("\n========== 多Agent协同运营系统 全部启动完成 ==========\n")

    def submit_op_task(self, task_id: str, task_type: TaskType, content: str):
        """提交运营任务"""
        task = OpTask(task_id=task_id, task_type=task_type, content=content)
        self.schedule_agent.add_task(task)

